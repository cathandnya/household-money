# household-money 環境変数サンプル
# `cp .env.example .env` してから値を編集する。
# `.env` 自体は gitignore 対象。

# --- データベース ---
# SQLite ファイルのパス。`file:` プレフィックスを付けたうえでプロジェクトルートからの
# 相対パスを書く。prisma 7 の挙動上、prisma 配下から見た相対なので `../data/...` になる。
DATABASE_URL="file:../data/money.db"

# --- サーバ ---
# Next.js の listen ポートとホスト名。
# `next dev` / `next start` ともにこれらの環境変数を尊重する。
# - PORT はサーバが listen するポート (デフォルト 3000、本プロジェクトは 3001)
# - HOSTNAME は listen するインターフェース。0.0.0.0 で LAN 公開、
#   127.0.0.1 でローカルのみ
PORT=3001
HOSTNAME=0.0.0.0

# --- LAN 上の別ホスト名でアクセスする場合 ---
# `localhost` 以外のホスト名 (例: `myhost.local`) で開くと Next.js のクロスオリジン
# 保護で HMR がブロックされる。アクセスを許可するホスト名をカンマ区切りで列挙。
# 例: ALLOWED_DEV_ORIGINS=myhost.local,other.local
ALLOWED_DEV_ORIGINS=
